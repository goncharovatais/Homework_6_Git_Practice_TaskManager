public interface IDamageCalculator
{
    int CalculateDamage(int baseDamage, int targetArmor);
}

public class PhysicalDamageCalculator : IDamageCalculator
{
    public int CalculateDamage(int baseDamage, int targetArmor)
    {
        int damage = baseDamage - (targetArmor / 2);
        return Math.Max(1, damage);
    }
}
public class MagicDamageCalculator : IDamageCalculator
{
    public int CalculateDamage(int baseDamage, int targetArmor)
    {
        int damage = baseDamage - (targetArmor / 4);
        damage = Math.Max(1, damage);
        if (targetArmor == 0)
        {
            damage *= 2;
        }
        return damage;
    }
}

public class FireDamageCalculator : IDamageCalculator
{
    public int CalculateDamage(int baseDamage, int targetArmor)
    {
        int damage = baseDamage - (targetArmor / 10);
        damage = Math.Max(1, damage);
        if (baseDamage > 50)
        {
            damage += 10;
        }
        return damage;
    }
}

public class Unit
{
    public string Name { get; set; }
    public int HP { get; set; }
    public int Armor { get; set; }

    public Unit(string name, int hp, int armor)
    {
        Name = name;
        HP = hp;
        Armor = armor;
    }
}

public class DamageSystem
{
    private readonly IDamageCalculator _damageCalculator;

    public DamageSystem(IDamageCalculator damageCalculator)
    {
        _damageCalculator = damageCalculator;
    }

    public void ApplyDamage(Unit target, int baseDamage)
    {
        int finalDamage = _damageCalculator.CalculateDamage(baseDamage, target.Armor);

        target.HP = Math.Max(0, target.HP - finalDamage);

        Console.WriteLine($"Юнит {target.Name} получил {finalDamage} урона. Осталось HP: {target.HP}");
    }
}

public class Задача23
{
    public static void Main()
    {
        Unit goblin1 = new Unit("Гоблин-воин", 100, 10);
        Unit goblin2 = new Unit("Гоблин-маг", 100, 10);
        Unit goblin3 = new Unit("Гоблин-танк", 100, 10);

        int baseDmg = 60;

        Console.WriteLine($"Наносим базовый урон {baseDmg} по трем одинаковым гоблинам разными типами урона:\n");

        
        DamageSystem physSystem = new DamageSystem(new PhysicalDamageCalculator());
        physSystem.ApplyDamage(goblin1, baseDmg);

        
        DamageSystem magicSystem = new DamageSystem(new MagicDamageCalculator());
        magicSystem.ApplyDamage(goblin2, baseDmg);

       
        DamageSystem fireSystem = new DamageSystem(new FireDamageCalculator());
        fireSystem.ApplyDamage(goblin3, baseDmg);
    }
}
